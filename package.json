{
  "name": "carb-me",
  "private": true,
  "version": "1.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run",
    "convert-bls": "tsx scripts/convert-bls-to-json.ts",
    "generate-maskable-icons": "node scripts/generate-maskable-icons.js"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^2.2.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "driver.js": "^1.10.2",
    "fuse.js": "^7.5.0"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0",
      "serialize-javascript": ">=7.0.5"
    }
  }
}
